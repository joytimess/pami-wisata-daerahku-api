# APPLICATION
APP_NAME="Wisata Daerahku"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pami-wisata-daerahku-api.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# STORAGE / QUEUE / CACHE
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Shared database or Redis store required across all app workers.
GEOCODING_CACHE_STORE=database
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT="WisataDaerahku/1.0 (+https://github.com/joytimess/pami-wisata-daerahku-api)"
GEOCODING_TIMEOUT=5
GEOCODING_CACHE_SECONDS=86400

# REDIS (OPTIONAL)
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# EMAIL
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="Wisata Daerahku"

# AWS (OPTIONAL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# API JWT AUTHENTICATION
JWT_SECRET=
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=wisata-daerahku-api

# FIREBASE AUTHENTICATION / FCM
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Password reset uses email OTP; PASSWORD_RESET_URL is no longer needed.

# VITE
VITE_APP_NAME="${APP_NAME}"

# Phase 0 + 1A rollout; DOKU remains disabled until Phase 1B integration.
APPROVAL_CLAIM_MODE=compat
PAYMENT_PREVIEW_ENABLED=false
DOKU_ENABLED=false
