# APPLICATION
APP_NAME="Wisata Daerahku"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pami-wisata-daerahku-api.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# STORAGE / QUEUE / CACHE
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Shared database or Redis store required across all app workers.
GEOCODING_CACHE_STORE=database
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT="WisataDaerahku/1.0 (+https://github.com/joytimess/pami-wisata-daerahku-api)"
GEOCODING_TIMEOUT=5
GEOCODING_CACHE_SECONDS=86400

# REDIS (OPTIONAL)
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# EMAIL
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM_ADDRESS=your-gmail@gmail.com
MAIL_FROM_NAME="Wisata Daerahku"

# AWS (OPTIONAL)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# API JWT AUTHENTICATION
JWT_SECRET=
JWT_ISSUER="${APP_URL}"
JWT_AUDIENCE=wisata-daerahku-api

# FIREBASE AUTHENTICATION / FCM
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Password reset uses email OTP; PASSWORD_RESET_URL is no longer needed.

# VITE
VITE_APP_NAME="${APP_NAME}"

# Operations and payment rollout
APPROVAL_CLAIM_MODE=compat
PAYMENT_PREVIEW_ENABLED=false
DEMO_PAYMENTS_ENABLED=false
DOKU_ENABLED=false
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Keep the merchant private key outside the public directory; register its public key with DOKU.
DOKU_MERCHANT_PRIVATE_KEY_PATH=
DOKU_MERCHANT_PRIVATE_KEY_PASSPHRASE=
# Merchant BNI BIN and Sub-BIN supplied by DOKU, not the Client ID.
DOKU_BNI_PARTNER_SERVICE_ID=
DOKU_BNI_CUSTOMER_PREFIX=
# Other VA banks. Values come from DOKU for your merchant; never reuse the BNI values or documentation samples.
# The notification CHANNEL-ID is read from a real Sandbox notification; the bank cannot settle payments until it is set.
DOKU_BCA_PARTNER_SERVICE_ID=
DOKU_BCA_CUSTOMER_PREFIX=
DOKU_BCA_NOTIFICATION_CHANNEL_ID=
DOKU_BRI_PARTNER_SERVICE_ID=
DOKU_BRI_CUSTOMER_PREFIX=
DOKU_BRI_NOTIFICATION_CHANNEL_ID=
DOKU_MANDIRI_PARTNER_SERVICE_ID=
DOKU_MANDIRI_CUSTOMER_PREFIX=
DOKU_MANDIRI_NOTIFICATION_CHANNEL_ID=
# Allowlist of intended channels (va_bni,va_bca,va_bri,va_mandiri,qris,ewallet_dana,ewallet_shopeepay,ewallet_ovo). Not proof of activation.
DOKU_CHANNELS=
# Channels confirmed on the real merchant account (BNI is grandfathered). New channels stay unavailable until listed here.
DOKU_VERIFIED_CHANNELS=
# QRIS merchant values come from your DOKU merchant account. Never use documentation samples.
DOKU_QRIS_MERCHANT_ID=
DOKU_QRIS_TERMINAL_ID=
DOKU_QRIS_POSTAL_CODE=
# E-wallet (DANA, ShopeePay). Return URL must be exactly https://<public-api-domain>/payment/return (route payment.return; no /api, no /v1,
# no query, no trailing slash). Redirect hosts is a comma list of hosts DOKU is confirmed to redirect to.
# ShopeePay path must be set explicitly: the official page lists both v1 and v2 (/direct-debit/core/v1|v2/debit/payment-host-to-host).
DOKU_EWALLET_RETURN_URL=
DOKU_EWALLET_REDIRECT_HOSTS=
DOKU_SHOPEEPAY_PAYMENT_PATH=
# Android App Links for the payment return page (/.well-known/assetlinks.json). Comma list of the app signing certificate SHA-256
# fingerprints (uppercase, colon-separated; include the Play App Signing certificate for store builds). Empty = not published.
MOBILE_ANDROID_PACKAGE=id.wisatadaerahku.app
MOBILE_ANDROID_SHA256_FINGERPRINTS=
DOKU_WEBHOOK_URL=
# Enable only after live channel, notification URL and merchant credentials are verified.
DOKU_PRODUCTION_APPROVED=false
DOKU_HTTP_TIMEOUT_SECONDS=15
DOKU_RECONCILIATION_ENABLED=true

# HTTPS origin used for the authenticated ticket-page link in "tickets ready" emails (empty = no link).
TICKET_LINK_BASE_URL=

# MIDTRANS SANDBOX
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=ISI_SERVER_KEY_SANDBOX_LO
MIDTRANS_ENABLED=false
# Expected merchant identity (mandatory in production). Channels are internal registry codes: va_bca,va_bni,qris.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CHANNELS=
# Production only: channels verified against the activated merchant account, plus an explicit approval gate.
MIDTRANS_VERIFIED_CHANNELS=
MIDTRANS_PRODUCTION_APPROVED=false
MIDTRANS_HTTP_TIMEOUT_SECONDS=10
MIDTRANS_MINIMUM_EXPIRY_SECONDS=30
MIDTRANS_QRIS_ACQUIRER=gopay
# Full-refund API for QRIS only; keep false until the Refund permission is confirmed on the merchant account.
MIDTRANS_QRIS_REFUND_ENABLED=false
MIDTRANS_QRIS_REFUND_WINDOW_DAYS=14
